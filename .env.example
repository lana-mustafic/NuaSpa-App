# Kopiraj u .env (ne commitaj .env).
# Flutter učitava vrijednosti pri runu/buildu:
#   flutter run --dart-define-from-file=.env
# ili pojedinačno:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:5088/api/

API_BASE_URL=http://127.0.0.1:5088/api/
STRIPE_PUBLISHABLE_KEY=

# Flutter web (browser CORS): run with a fixed port that matches API Cors:AllowedOrigins
#   flutter run -d chrome --web-port=8080 --dart-define-from-file=.env
# Use the same host style as your web origin (localhost vs 127.0.0.1).
# API_BASE_URL=http://localhost:5088/api/
